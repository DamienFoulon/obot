# Discord application (https://discord.com/developers/applications)
APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
# Optional: register the commands on this server only (instant updates while developing)
GUILD_ID=
PORT=3000

# Branding
OBOT_COLOR=#0193CF
OBOT_LOGO_LINK=

# Welcome / leave messages, "{user}" is replaced by the member
WELCOME_CHANNEL_ID=
WELCOME_PUBLIC_MESSAGE=Welcome {user} ! 🎉
LEAVE_CHANNEL_ID=
LEAVE_PUBLIC_MESSAGE={user} left the server 😭

# Jobs feature
JOB_CHANNEL_ID=
JOB_VALIDATION_CHANNEL_ID=
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Music feature (needs yt-dlp and ffmpeg, see the README)
# Path of the yt-dlp binary, when it isn't in the PATH
YTDLP_PATH=
# Cookies file of a Google account, when YouTube asks to "confirm you're not a bot"
YTDLP_COOKIES=
# Optional: only this role (and administrators) can skip, stop, pause, change the volume or the loop
DJ_ROLE_ID=
